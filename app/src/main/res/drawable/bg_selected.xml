<?xml version="1.0" encoding="utf-8"?>
<!-- Multi-select: Blood Moon tint + accent ring over a selected thumbnail / row. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp"/>
    <solid android:color="@color/selection_tint"/>
    <stroke android:width="2.5dp" android:color="@color/accent"/>
</shape>

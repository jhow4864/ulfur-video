<!-- 1.5.1: round danger button (bulk delete) - red-tinted fill, red outline, ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FF453A">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/danger_bg"/>
            <stroke android:width="1dp" android:color="@color/danger_stroke"/>
        </shape>
    </item>
</ripple>

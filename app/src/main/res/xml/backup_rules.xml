<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (fullBackupContent): private videos never go to backups. -->
<full-backup-content>
    <exclude domain="file" path="vault/"/>
    <!-- 1.6.0: the vault keyset is wrapped by a Keystore key that never leaves this phone -->
    <exclude domain="sharedpref" path="ulfur_vault_keyset.xml"/>
    <exclude domain="sharedpref" path="private_resume.xml"/>
    <!-- 1.6.0: per-video bookmarks (names) and remembered speeds -->
    <exclude domain="sharedpref" path="bookmarks.xml"/>
    <exclude domain="sharedpref" path="speeds.xml"/>
</full-backup-content>

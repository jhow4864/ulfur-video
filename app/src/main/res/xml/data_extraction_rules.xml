<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: private videos are excluded from cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vault/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vault/"/>
    </device-transfer>
</data-extraction-rules>

<paths>
    <!-- Private videos (vault/) are deliberately NOT served here since 1.6.0: they are encrypted
         and only read through VaultDataSource / VaultMediaDataSource. -->
    <cache-path name="sample" path="sample/"/>
    <cache-path name="exports" path="exports/"/>
    <external-files-path name="saved_movies" path="Movies/"/>
    <external-files-path name="saved_pictures" path="Pictures/"/>
    <!-- Android 9 and older: exports saved to the public Movies/Pictures VideoPlayer folders -->
    <external-path name="public_movies" path="Movies/VideoPlayer/"/>
    <external-path name="public_pictures" path="Pictures/VideoPlayer/"/>
</paths>

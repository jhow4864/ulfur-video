<resources>
    <!-- 1.6: section label row used in the subtitles and bookmarks sheets -->
    <style name="SubsSheetLabelRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="SubsSheetLabelBar">
        <item name="android:layout_width">3dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/bg_accent_bar</item>
    </style>
    <!-- A subtitle track row: check mark on the right when selected -->
    <style name="SubsTrackRow" parent="MenuRow">
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">64dp</item>
    </style>
</resources>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:show_buffering="never"
        app:resize_mode="fit"
        app:shutter_background_color="@android:color/black"
        app:keep_content_on_player_reset="true"/>

    <!-- Touch layer for gestures -->
    <View
        android:id="@+id/gesture_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FFFFFFFF"
        android:visibility="gone"/>

    <!-- Brightness / volume / zoom indicator -->
    <LinearLayout
        android:id="@+id/gesture_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_round_dark"
        android:gravity="center"
        android:minWidth="150dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/gesture_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:tint="#FFFFFFFF"/>

        <TextView
            android:id="@+id/gesture_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <ProgressBar
            android:id="@+id/gesture_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_resume"/>
    </LinearLayout>

    <!-- Seek / scrub indicator -->
    <TextView
        android:id="@+id/seek_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="72dp"
        android:background="@drawable/bg_round_dark"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone"/>

    <!-- Double-tap skip feedback -->
    <TextView
        android:id="@+id/skip_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="64dp"
        android:background="@drawable/bg_round_dark"
        android:drawableTop="@drawable/ic_fast_rewind"
        android:gravity="center"
        android:padding="14dp"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/skip_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="64dp"
        android:background="@drawable/bg_round_dark"
        android:drawableTop="@drawable/ic_fast_forward"
        android:gravity="center"
        android:padding="14dp"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:visibility="gone"/>

    <!-- Controls -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/gradient_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <ImageButton android:id="@+id/btn_back" style="@style/PlayerIconButton" android:src="@drawable/ic_arrow_back" android:contentDescription="Back"/>

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"/>

            <TextView
                android:id="@+id/badge_night"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Night mode"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/badge_sleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_badge"
                android:drawableStart="@drawable/ic_timer_small"
                android:drawablePadding="4dp"
                android:drawableTint="#FFFFFFFF"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/btn_speed"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_button"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="1.0x"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <ImageButton android:id="@+id/btn_upscale" style="@style/PlayerIconButton" android:src="@drawable/ic_upscale" android:contentDescription="Upscale"/>
            <ImageButton android:id="@+id/btn_audio" style="@style/PlayerIconButton" android:src="@drawable/ic_audiotrack" android:contentDescription="Audio track"/>
            <ImageButton android:id="@+id/btn_subs" style="@style/PlayerIconButton" android:src="@drawable/ic_subtitles" android:contentDescription="Subtitles"/>
            <ImageButton android:id="@+id/btn_pip" style="@style/PlayerIconButton" android:src="@drawable/ic_pip" android:contentDescription="Picture-in-picture"/>
            <ImageButton android:id="@+id/btn_more" style="@style/PlayerIconButton" android:src="@drawable/ic_more" android:contentDescription="More"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/center_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton android:id="@+id/btn_prev" style="@style/PlayerIconButton" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_skip_previous" android:contentDescription="Previous"/>
            <ImageButton android:id="@+id/btn_rew" style="@style/PlayerIconButton" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="20dp" android:src="@drawable/ic_fast_rewind" android:contentDescription="Back 10 seconds"/>
            <ImageButton android:id="@+id/btn_play" style="@style/PlayerIconButton" android:layout_width="76dp" android:layout_height="76dp" android:padding="16dp" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:background="@drawable/bg_center_play" android:src="@drawable/ic_pause" android:contentDescription="Play/pause"/>
            <ImageButton android:id="@+id/btn_ffwd" style="@style/PlayerIconButton" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginEnd="20dp" android:src="@drawable/ic_fast_forward" android:contentDescription="Forward 10 seconds"/>
            <ImageButton android:id="@+id/btn_next" style="@style/PlayerIconButton" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_skip_next" android:contentDescription="Next"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_bottom"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="32dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="56dp"
                    android:gravity="center"
                    android:text="0:00"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"/>

                <!-- 1.6: bookmark ticks drawn over the seek bar (not touchable) -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1">

                    <SeekBar
                        android:id="@+id/seekbar"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:progressTint="?attr/colorPrimary"
                        android:thumbTint="?attr/colorPrimary"
                        android:secondaryProgressTint="#99FFFFFF"
                        android:progressBackgroundTint="#55FFFFFF"/>

                    <com.jamh.videoplayer.BookmarkTicksView
                        android:id="@+id/bookmark_ticks"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="56dp"
                    android:gravity="center"
                    android:text="0:00"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton android:id="@+id/btn_lock" style="@style/PlayerIconButton" android:src="@drawable/ic_lock_open" android:contentDescription="Lock screen"/>
                <ImageButton android:id="@+id/btn_rotation_lock" style="@style/PlayerIconButton" android:src="@drawable/ic_screen_lock_rotation" android:contentDescription="Rotation lock"/>
                <ImageButton android:id="@+id/btn_bookmark" style="@style/PlayerIconButton" android:src="@drawable/ic_bookmark_add" android:contentDescription="Bookmark this moment (long-press for bookmarks)"/>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <TextView
                    android:id="@+id/aspect_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"/>
                <ImageButton android:id="@+id/btn_aspect" style="@style/PlayerIconButton" android:src="@drawable/ic_aspect" android:contentDescription="Aspect ratio"/>
                <ImageButton android:id="@+id/btn_rotate" style="@style/PlayerIconButton" android:src="@drawable/ic_rotate" android:contentDescription="Rotate screen"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Scrub thumbnail: positioned above the seek-bar thumb / finger while scrubbing -->
    <LinearLayout
        android:id="@+id/scrub_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:elevation="6dp"
        android:visibility="gone">
        <FrameLayout
            android:id="@+id/scrub_preview_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scrub_thumb"
            android:padding="1.5dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/scrub_preview_image"
                android:layout_width="160dp"
                android:layout_height="90dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.VideoPlayer.ScrubThumb"/>
        </FrameLayout>
        <TextView
            android:id="@+id/scrub_preview_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_round_dark"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"/>
    </LinearLayout>

    <!-- 1.5.0: quick label shown when Upscale is toggled -->
    <LinearLayout
        android:id="@+id/upscale_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="88dp"
        android:background="@drawable/bg_upscale_toast"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="18dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:visibility="gone">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_upscale"
            app:tint="@color/accent"
            android:importantForAccessibility="no"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/upscale_toast_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/heading"
                android:textColor="@color/text_primary"
                android:textSize="15sp"/>
            <TextView
                android:id="@+id/upscale_toast_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFeatureSettings="tnum"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_unlock"
        style="@style/PlayerIconButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="32dp"
        android:background="@drawable/bg_center_play"
        android:padding="14dp"
        android:src="@drawable/ic_lock"
        android:visibility="gone"
        android:contentDescription="Unlock"/>
</FrameLayout>

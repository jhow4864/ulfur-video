<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vault_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/private_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/vault_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/private_bg"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/vault_title"
        app:titleTextAppearance="@style/TextAppearance.Ulfur.Title"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/private_stroke"/>

    <!-- Locked state (also used for "no screen lock set up") -->
    <LinearLayout
        android:id="@+id/vault_locked"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/vault_locked_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_center_play"
            android:padding="18dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/private_ink"
            android:backgroundTint="@color/private_stroke"
            android:importantForAccessibility="no"/>

        <TextView
            android:id="@+id/vault_locked_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/vault_locked_title"
            android:fontFamily="@font/heading"
            android:letterSpacing="0.04"
            android:textAppearance="?attr/textAppearanceTitleLarge"/>

        <TextView
            android:id="@+id/vault_locked_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="360dp"
            android:text="@string/vault_locked_body"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vault_unlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/vault_unlock"
            app:icon="@drawable/ic_lock_open"/>
    </LinearLayout>

    <!-- Unlocked content -->
    <LinearLayout
        android:id="@+id/vault_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/warn_bg"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/warn"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/warn"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:id="@+id/vault_warning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/vault_warning"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnErrorContainer"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1.6.0: encrypting videos from older versions (progress / failures) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/vault_migration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface2"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/private_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/vault_migration_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Ulfur.Label"
                    android:textColor="@color/private_ink"/>

                <TextView
                    android:id="@+id/vault_migration_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"/>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/vault_migration_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    app:indicatorColor="@color/private_ink"
                    app:trackColor="@color/private_stroke"
                    app:trackCornerRadius="3dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/vault_migration_retry"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/vault_migration_retry"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/vault_storage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Ulfur.Label"
                android:textColor="@color/private_ink"/>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/vault_storage_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="1000"
                app:indicatorColor="@color/accent"
                app:trackColor="@color/private_stroke"
                app:trackCornerRadius="3dp"/>

            <TextView
                android:id="@+id/vault_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/vault_hint"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vault_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="6dp"/>

            <TextView
                android:id="@+id/vault_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:maxWidth="320dp"
                android:padding="24dp"
                android:text="@string/vault_empty"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"/>

            <!-- 1.4.0 multi-select: bulk actions -->
            <LinearLayout
                android:id="@+id/vault_selection_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="16dp"
                android:background="@drawable/bg_selection_bar"
                android:elevation="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/vault_select_all"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:text="@string/select_all"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/inter_semibold"
                    android:textSize="14sp"
                    android:focusable="true"
                    android:clickable="true"/>

                <ImageView
                    android:id="@+id/vault_delete_selected"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/delete_selected"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/danger"/>

                <TextView
                    android:id="@+id/vault_move_out_selected"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_gradient_button"
                    android:fontFamily="@font/heading"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:text="@string/move_out_selected"
                    android:textColor="@color/on_accent"
                    android:textSize="15sp"
                    android:focusable="true"
                    android:clickable="true"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

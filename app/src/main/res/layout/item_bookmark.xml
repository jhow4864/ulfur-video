<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bookmark_row"
    style="@style/MenuRow"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/bookmark_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_bookmark_time"
        android:fontFamily="@font/inter_semibold"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:minWidth="64dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp"/>

    <LinearLayout style="@style/MenuRowTexts">
        <TextView
            android:id="@+id/bookmark_name"
            style="@style/MenuRowTitle"
            android:ellipsize="end"
            android:maxLines="2"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/bookmark_more"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Rename or delete"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_more"
        app:tint="@color/text_secondary"/>
</LinearLayout>

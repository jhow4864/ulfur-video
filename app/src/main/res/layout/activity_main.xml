<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:logo="@drawable/ic_app_mark"
        app:titleMarginStart="14dp"
        app:title="@string/app_name"
        app:titleTextAppearance="@style/TextAppearance.Ulfur.Title"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:tabIndicatorFullWidth="false"
        app:tabIndicator="@drawable/tab_indicator"
        app:tabIndicatorHeight="3dp"
        app:tabRippleColor="@color/selection_tint"
        app:tabTextAppearance="@style/TextAppearance.Ulfur.Tab"
        app:tabTextColor="?attr/colorOnSurfaceVariant"
        app:tabSelectedTextColor="?attr/colorOnSurface"
        app:tabIndicatorColor="?attr/colorPrimary"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/default_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="20dp"
        app:strokeColor="@color/stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="14dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:text="@string/banner_title"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/inter_semibold"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/default_banner_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingEnd="8dp"
                android:text="@string/banner_text"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/banner_dismiss"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/banner_dismiss"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/banner_setup"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/banner_setup"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView
        android:id="@+id/clips_filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/clips_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_clips_both"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Portrait or short"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_clips_portrait"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Portrait"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_clips_short"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Under 3 min"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- 1.7.0: sort / Largest first / filter chips -->
    <HorizontalScrollView
        android:id="@+id/library_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/library_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true"/>
    </HorizontalScrollView>

    <!-- 1.7.0: Largest first storage view summary -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/storage_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface2"
        app:cardCornerRadius="18dp"
        app:strokeColor="@color/stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_storage"
                app:tint="@color/accent"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/storage_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/heading"
                    android:letterSpacing="0.03"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/storage_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/storage_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_danger_button"
                android:fontFamily="@font/inter_semibold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="@color/danger"
                android:textSize="13sp"
                android:visibility="gone"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Ulfur section label: accent bar + spaced caps (like SPEED DIAL in the browser) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp">

        <View
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_accent_bar"/>

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Ulfur.Label"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="24dp"/>

        <LinearLayout
            android:id="@+id/empty_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_app_mark"/>

            <TextView
                android:id="@+id/empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_permission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/allow_access"/>
        </LinearLayout>

        <!-- 1.4.0 multi-select: bulk action bar -->
        <LinearLayout
            android:id="@+id/selection_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_selection_bar"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/selection_select_all"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/select_all"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/inter_semibold"
                android:textSize="14sp"
                android:focusable="true"
                android:clickable="true"/>

            <!-- 1.5.1: bulk delete (danger red) next to Move to Private -->
            <ImageView
                android:id="@+id/selection_delete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:padding="12dp"
                android:background="@drawable/bg_danger_button"
                android:contentDescription="@string/delete_selected_videos"
                android:src="@drawable/ic_delete"
                android:focusable="true"
                android:clickable="true"
                app:tint="@color/danger"/>

            <TextView
                android:id="@+id/selection_move_private"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_gradient_button"
                android:drawablePadding="8dp"
                android:fontFamily="@font/heading"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:text="@string/move_selected_to_private"
                android:textColor="@color/on_accent"
                android:textSize="16sp"
                android:focusable="true"
                android:clickable="true"/>
        </LinearLayout>
    </FrameLayout>
    <!-- 1.7.0: Cast mini controller (added at runtime when Google Cast is available) -->
    <FrameLayout
        android:id="@+id/cast_mini_controller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"/>
</LinearLayout>
